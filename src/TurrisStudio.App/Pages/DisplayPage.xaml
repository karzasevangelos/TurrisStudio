<UserControl x:Class="TurrisStudio.Pages.DisplayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="Display" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Screen settings. They're saved and re-applied automatically." Style="{StaticResource PageSubtitle}" />

            <ui:CardControl Icon="{ui:SymbolIcon BrightnessHigh24}" Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Brightness" FontWeight="SemiBold" />
                        <TextBlock Text="Backlight level of the cooler screen" Style="{StaticResource Muted}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <Slider x:Name="BrightnessSlider" Width="260" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                            ValueChanged="Brightness_Changed" VerticalAlignment="Center" />
                    <TextBlock x:Name="BrightnessText" Width="48" TextAlignment="Right" VerticalAlignment="Center" Text="100%" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon Desktop24}" Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Screen on" FontWeight="SemiBold" />
                        <TextBlock Text="Turn the backlight off without unplugging anything" Style="{StaticResource Muted}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="BacklightToggle" Click="Setting_Changed" />
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon FlipHorizontal24}" Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Mirror / flip" FontWeight="SemiBold" />
                        <TextBlock Text="Use this if the screen is mounted upside-down" Style="{StaticResource Muted}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="MirrorToggle" Click="Setting_Changed" />
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon Play24}" Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Playback" FontWeight="SemiBold" />
                        <TextBlock Text="Repeat one file, or loop or shuffle through everything on the cooler" Style="{StaticResource Muted}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="PlayModeBox" Width="230" SelectionChanged="Setting_Changed">
                    <ComboBoxItem Content="Repeat the selected file" />
                    <ComboBoxItem Content="Loop through all files" />
                    <ComboBoxItem Content="Shuffle all files" />
                </ComboBox>
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon Layer24}" Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Stats overlay" FontWeight="SemiBold" />
                        <TextBlock Text="Show your overlay design on top of the media" Style="{StaticResource Muted}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="OverlayToggle" Click="Overlay_Click" />
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon ArrowSync24}" Margin="0,0,0,8">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Update rate" FontWeight="SemiBold" />
                        <TextBlock Text="How often stats are sent to the screen" Style="{StaticResource Muted}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="IntervalBox" Width="160" SelectionChanged="Interval_Changed">
                    <ComboBoxItem Content="0.5 seconds" Tag="500" />
                    <ComboBoxItem Content="1 second" Tag="1000" />
                    <ComboBoxItem Content="2 seconds" Tag="2000" />
                    <ComboBoxItem Content="5 seconds" Tag="5000" />
                </ComboBox>
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
