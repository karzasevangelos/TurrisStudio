<UserControl x:Class="TurrisStudio.Pages.SensorsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <DockPanel Margin="32,24,32,24">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Sensors" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Every value you can put on the screen. “Automatic” entries pick the right sensor for you."
                       Style="{StaticResource PageSubtitle}" />
            <ui:InfoBar x:Name="HwInfoBar" Title="CPU temperature needs administrator rights" IsClosable="False" Severity="Informational" Margin="0,0,0,12"
                        Message="Open Turris Studio from its Start-menu shortcut (it starts with full access, without a prompt), or run HWiNFO with “Shared Memory Support” ticked. GPU, memory and usage readings work either way." />
            <ui:TextBox x:Name="SearchBox" PlaceholderText="Search sensors (e.g. cpu temp, gpu power, fan)" Icon="{ui:SymbolIcon Search24}"
                        TextChanged="SearchBox_TextChanged" Margin="0,0,0,12" />
        </StackPanel>
        <ListView x:Name="SensorList">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Sensor" Width="320" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Group" Width="320" DisplayMemberBinding="{Binding Group}" />
                    <GridViewColumn Header="Value" Width="120" DisplayMemberBinding="{Binding ValueText}" />
                    <GridViewColumn Header="Source" Width="110" DisplayMemberBinding="{Binding Source}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
